---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import VizSurface from '../components/VizSurface.astro';
import VizPlaceholder from '../components/VizPlaceholder.astro';
import Footer from '../components/sections/Footer.astro';
import {
  MemoryDistill,
  SessionDurability,
  SessionTimeline,
} from '@metaharness/animations';

const title = 'Memory is not one thing';
const description =
  'A map of what agentic memory can mean: working, episodic, and semantic memory, who it is for, and why code is the one place memory behaves differently.';

const navLinks = [
  { href: '#types', label: 'The three types' },
  { href: '#map', label: 'The second axis' },
  { href: '#capture', label: 'The agent session' },
  { href: '#why', label: 'Why it matters' },
  { href: '#what-it-does', label: 'What it lets you do' },
];

// Lucide-style icons (24x24, stroke currentColor), rendered inline before each row title.
const icons: Record<string, string> = {
  eye: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  loop: '<path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>',
  users:
    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  userCheck:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/>',
  // Memory types.
  scratchpad:
    '<path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.4 2.6a2.1 2.1 0 1 1 3 3L12 15l-4 1 1-4Z"/>',
  filmstrip:
    '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M17 3v18"/><path d="M3 12h18"/>',
  book: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  // Who the memory is for.
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  building:
    '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M10 7h4"/><path d="M10 11h4"/><path d="M10 15h4"/><path d="M4 22h16"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
};

const renderIcon = (name: string) =>
  `<svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
---

<Layout title={title} description={description}>
  <Nav links={navLinks} />
  <main
    class="bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100"
  >
    <!-- Hero -->
    <section
      id="top"
      class="relative flex min-h-[calc(100svh-61px)] flex-col justify-center px-6"
    >
      <div class="mx-auto w-full max-w-4xl">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent">
          Agentic memory
        </p>
        <h1
          class="mt-6 text-5xl font-semibold tracking-tight text-neutral-900 sm:text-7xl dark:text-neutral-50"
        >
          Memory is not one thing.
        </h1>
        <p
          class="mt-8 max-w-2xl text-xl leading-relaxed text-neutral-600 sm:text-2xl dark:text-neutral-400"
        >
          Everyone building agents talks about memory. Almost none of them mean
          the same thing by it. It runs along two axes:
          <mark>what kind of memory it is, and who it is for</mark>. Here is a map
          of both, and why code is the one place memory behaves differently.
        </p>
      </div>
      <div
        class="absolute inset-x-0 bottom-6 flex flex-col items-center gap-1 font-mono text-xs uppercase tracking-[0.2em] text-neutral-500 dark:text-neutral-600"
      >
        <span>Scroll down</span>
        <span aria-hidden="true">&darr;</span>
      </div>
    </section>

    <!-- 1. The three types -->
    <section id="types" class="px-6 py-20 md:py-28">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <h2
            class="text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-50"
          >
            Three kinds of memory
          </h2>
          <p
            class="mt-6 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            Cognitive science already split memory into parts, and the same
            split fits agents almost too well. There are three different kinds serving three different jobs.
          </p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          <div
            class="flex flex-col rounded-xl border border-neutral-300 bg-neutral-100/60 p-7 dark:border-neutral-800 dark:bg-neutral-900/40"
          >
            <h3
              class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
            >
              <span class="text-accent" set:html={renderIcon('scratchpad')} />
              Working memory
            </h3>
            <p
              class="mt-3 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
            What the agent holds while it is doing the work. The <mark>context
              window</mark>{' '}plus a few affordances stacked on top, like a scratchpad
              file it keeps updating. Short-lived and scoped to a single
              session. This is where orchestration lives.
            </p>
          </div>

          <div
            class="flex flex-col rounded-xl border border-neutral-300 bg-neutral-100/60 p-7 dark:border-neutral-800 dark:bg-neutral-900/40"
          >
            <h3
              class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
            >
              <span class="text-accent" set:html={renderIcon('filmstrip')} />
              Episodic memory
            </h3>
            <p
              class="mt-3 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
            This is like <mark>the recording</mark> tied to a specific unit of work. It doesn't summarize but is the exact recollection of what happened during a session including what was tried, what got rejected and what survided into the final merge.
            </p>
          </div>

          <div
            class="flex flex-col rounded-xl border border-neutral-300 bg-neutral-100/60 p-7 dark:border-neutral-800 dark:bg-neutral-900/40"
          >
            <h3
              class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
            >
              <span class="text-accent" set:html={renderIcon('book')} />
              Semantic memory
            </h3>
            <p
              class="mt-3 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
            The <mark>distilled version</mark>. Facts, PRDs, design docs, "here is how our
              auth works." Either boiled down from a recording after the fact,
              or written by hand up front. These are usually shorter, but also tend to be lossy.
            </p>
          </div>
        </div>

        <p
          class="mx-auto mt-12 max-w-3xl text-center text-lg text-neutral-600 dark:text-neutral-400"
        >
          Most tools that say "memory" mean the semantic kind, because a list of
          facts is the easiest thing to show.
        </p>
      </div>
    </section>

    <!-- 2. The second axis + the map (merged) -->
    <section id="map" class="px-6 pb-20 md:pb-28">
      <div class="mx-auto max-w-6xl">
        <div>
          <h2
            class="text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-50"
          >
            The second axis: who is the memory for?
          </h2>
          <p
            class="mt-6 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            The three types are one dimension. Cutting across them is a second
            question, and it has nothing to do with how the memory is stored but rather
            "who is it about?"
          </p>
        </div>

        <dl class="mt-12 grid gap-6 lg:grid-cols-3">
          <div
            class="flex flex-col rounded-xl border border-neutral-300 bg-neutral-100/60 p-7 dark:border-neutral-800 dark:bg-neutral-900/40"
          >
            <dt
              class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
            >
              <span class="text-accent" set:html={renderIcon('user')} />
              Personalized memory
            </dt>
            <dd
              class="mt-3 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
              About you. What you want, how you like to work, which patterns you
              reach for. Usually stored as a semantic profile of preferences.
            </dd>
          </div>
          <div
            class="flex flex-col rounded-xl border border-neutral-300 bg-neutral-100/60 p-7 dark:border-neutral-800 dark:bg-neutral-900/40"
          >
            <dt
              class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
            >
              <span class="text-accent" set:html={renderIcon('building')} />
              Institutional memory
            </dt>
            <dd
              class="mt-3 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
              The same idea scaled to a team, and it is far harder, not for
              technical reasons but for human ones. One person is easy to agree
              with. Teams rarely agree cleanly on how things should be done, so
              the document that claims to speak for the team is usually a
              <mark>negotiated fiction</mark>.
            </dd>
          </div>
          <div
            class="flex flex-col rounded-xl border border-neutral-300 bg-neutral-100/60 p-7 dark:border-neutral-800 dark:bg-neutral-900/40"
          >
            <dt
              class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
            >
              <span class="text-accent" set:html={renderIcon('code')} />
              Code
            </dt>
            <dd
              class="mt-3 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
              The odd one out. Not about you or your team, but about how the
              code itself came to be. Not "she likes tabs" but "this retry
              exists because the payment API times out under load, and here is
              the session where that was found and fixed."
            </dd>
          </div>
        </dl>

      </div>
    </section>

    <!-- 3. The agent session: record, then distill -->
    <section
      id="capture"
      class="border-y border-neutral-200 bg-neutral-100/60 px-6 py-20 md:py-28 dark:border-neutral-900 dark:bg-neutral-900/40"
    >
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <h2
            class="text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-50"
          >
            At the core is the agent session
          </h2>
          <p
            class="mt-6 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            Wherever you land on that map, the memory has to come from
            somewhere, and there is only one place it can come from: a agent session. Whenever you work with an agent, we want to take that working memory and turn it into episodic memory.
          </p>
        </div>

        <!-- Record it -->
        <div class="mt-14 min-w-0">
          <div
            class="grid min-w-0 items-center gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]"
          >
            <div>
              <h3
                class="text-xl font-semibold tracking-tight text-neutral-900 sm:text-2xl dark:text-neutral-50"
              >
                Capture the session
              </h3>
              <p
                class="mt-4 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
              >
                Episodic memory is not summarized after the fact, it is captured
                as it happens. Each session is kept whole as its own recording,
                from the goal it started with through every attempt that failed
                on the way to the change that shipped. Nothing is thrown away,
                because you cannot know up front which detail turns out to
                matter.
              </p>
            </div>

            <div class="-mx-6 min-w-0 md:mx-0">
              <VizSurface aspect="aspect-[12/7]">
                <SessionDurability
                  client:visible
                  captureOnly
                  className="mx-auto"
                />
              </VizSurface>
            </div>
          </div>

          <p
            class="mt-10 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            By default a session vanishes the moment the agent stops. A
            meta-harness sits around the harness the agent runs in, which puts
            it in a position to automate the capture: every run recorded as it
            happens and kept somewhere central. That is
            <mark>what turns a one-off run into something the next session can
              reach for</mark
            >.
          </p>
        </div>

        <!-- Distill it -->
        <div
          class="mt-16 grid min-w-0 items-center gap-10 border-t border-neutral-200 pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] dark:border-neutral-900"
        >
          <div class="lg:order-last">
            <h3
              class="text-xl font-semibold tracking-tight text-neutral-900 sm:text-2xl dark:text-neutral-50"
            >
              Then distill it
            </h3>
            <div
              class="mt-4 space-y-5 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
              <p>
                Recordings are exact but heavy. Over time an offline pass can
                read across finished sessions and consolidate them into shorter,
                general knowledge, a step sometimes called <mark>dreaming</mark>.
                Future sessions connect to that pool and start with what earlier
                ones learned instead of from a cold context.
              </p>
              <p>
              This is semantic memory, built over time, directly distilled
                from real recordings rather than hand-written up front. That way it stays
                anchored to what actually happened, and you can always walk back
                to the session it came from and check.
              </p>
            </div>
          </div>

          <div class="-mx-6 min-w-0 md:mx-0">
            <VizSurface>
              <MemoryDistill client:visible className="mx-auto" />
            </VizSurface>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Git keeps the what, the session keeps the why -->
    <section id="why" class="px-6 py-20 md:py-28">
      <div class="mx-auto max-w-6xl">
        <h2
          class="text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-50"
        >
          Why memory matters
        </h2>

        <p
          class="mt-6 max-w-3xl text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
        >
          Version control already remembers your code. It can tell you
          <mark>what any file looked like</mark> on any day and who changed it. The
          history shows a retry wrapper going in around the payment client. What
          it never captured is the reasoning behind any of it. It is the
          <mark>session that shows you why</mark> the wrapper exists: the payment
          API times out under load, someone worked that out the hard way, and the
          fix is what you are looking at.
        </p>

        <div class="mt-14 grid min-w-0 items-center gap-12 lg:grid-cols-2">
          <div class="-mx-6 min-w-0 md:mx-0">
            <VizPlaceholder
              label="git keeps the what, the session keeps the why"
              ratio="aspect-[6/5]"
            />
          </div>

          <div>
            <h3
              class="text-xl font-semibold tracking-tight text-neutral-900 sm:text-2xl dark:text-neutral-50"
            >
              Memory is valuable context
            </h3>
            <div
              class="mt-4 space-y-6 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
            <p>
              An agent always has an answer. Point one at an unfamiliar corner
              of the system and it reads what is there, finds something that
              looks broken, and tells you so with complete confidence. That
              confidence is not a signal of anything. It is what a model does
              when the current state of the code is all it has to go on.
            </p>
            <p>
              Give it the sessions behind that code and the answer can reverse.
              What looked like a bug turns out to be a deliberate tradeoff, made
              after a production incident, by someone who had already tried the
              obvious fix and watched it fail. The model did not get smarter. It
              got the context it was missing.
            </p>
            </div>
          </div>
        </div>

        <figure
          class="mx-auto mt-14 max-w-4xl border-y border-neutral-300 py-10 text-center dark:border-neutral-800"
        >
          <p
            class="text-2xl font-medium leading-snug text-neutral-900 sm:text-3xl dark:text-neutral-100"
          >
            Git has the what. Agent sessions have the{' '}
            <span class="text-accent">why</span>.
          </p>
        </figure>
      </div>
    </section>

    <!-- 5. What memory lets you do -->
    <section
      id="what-it-does"
      class="border-y border-neutral-200 bg-neutral-100/60 px-6 py-20 md:py-28 dark:border-neutral-900 dark:bg-neutral-900/40"
    >
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <h2
            class="text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-50"
          >
            What memory lets you do
          </h2>
          <p
            class="mt-6 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
          >
            Once an agent can reach the memory of past work, a set of moves
            opens up that a pile of facts could never support.
          </p>
        </div>

        <!-- Capability rows -->
        <div class="mt-14 space-y-12">
          <div
            class="grid min-w-0 items-center gap-10 pt-2 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]"
          >
            <div>
              <h3
                class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
              >
                <span class="text-accent" set:html={renderIcon('eye')} />
                Review the session, not just the diff
              </h3>
              <p
                class="mt-3 text-base leading-relaxed text-neutral-600 dark:text-neutral-400"
              >
                Open the recording behind a coworker's change and ask what
                options they weighed and why it landed this way, instead of
                reverse-engineering intent from a diff.
              </p>
            </div>
            <VizPlaceholder
              label="review the session behind a change"
              ratio="aspect-[16/9]"
            />
          </div>

          <div
            class="grid min-w-0 items-center gap-10 border-t border-neutral-200 pt-12 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] dark:border-neutral-900"
          >
            <div>
              <h3
                class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
              >
                <span class="text-accent" set:html={renderIcon('link')} />
                From a line of code to the session that wrote it
              </h3>
              <p
                class="mt-3 text-base leading-relaxed text-neutral-600 dark:text-neutral-400"
              >
                Take one line of code, follow it back to the session that
                produced it, and read the decision behind it in full.
              </p>
            </div>
            <VizPlaceholder label="line to session" ratio="aspect-[16/9]" />
          </div>

          <div
            class="grid min-w-0 items-center gap-10 border-t border-neutral-200 pt-12 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] dark:border-neutral-900"
          >
            <div>
              <h3
                class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
              >
                <span class="text-accent" set:html={renderIcon('loop')} />
                Resume anyone's work
              </h3>
              <p
                class="mt-3 text-base leading-relaxed text-neutral-600 dark:text-neutral-400"
              >
                Pick up a teammate's half-finished session on your own machine
                and carry it forward, instead of starting cold.
              </p>
            </div>
            <VizSurface>
              <SessionDurability client:visible className="mx-auto" />
            </VizSurface>
          </div>

          <div
            class="grid min-w-0 items-center gap-10 border-t border-neutral-200 pt-12 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] dark:border-neutral-900"
          >
            <div>
              <h3
                class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
              >
                <span class="text-accent" set:html={renderIcon('users')} />
                Build on what the team already did
              </h3>
              <p
                class="mt-3 text-base leading-relaxed text-neutral-600 dark:text-neutral-400"
              >
                Someone has almost certainly worked through the area you are
                about to touch. Shared, resumable sessions turn hundreds of
                isolated runs into memory the whole org can build on.
              </p>
            </div>
            <VizSurface>
              <SessionTimeline client:visible className="mx-auto" />
            </VizSurface>
          </div>

          <div
            class="grid min-w-0 items-start gap-10 border-t border-neutral-200 pt-12 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] dark:border-neutral-900"
          >
            <div>
              <h3
                class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
              >
                <span class="text-accent" set:html={renderIcon('userCheck')} />
                Know who to ask
              </h3>
              <p
                class="mt-3 text-base leading-relaxed text-neutral-600 dark:text-neutral-400"
              >
                Answer questions about people, not just code: who is the domain
                expert for the kind of change you are about to make, and who
                should review it.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Where this fits: orientation for anyone landing straight on this page -->
    <section
      id="close"
      class="px-6 py-20 md:py-24"
    >
      <div class="mx-auto max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent">
          Where this fits
        </p>
        <h2
          class="mt-6 text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl dark:text-neutral-50"
        >
          Memory is one capability of a meta-harness
        </h2>
        <p
          class="mt-6 text-lg leading-relaxed text-neutral-700 dark:text-neutral-300"
        >
          A meta-harness is the layer above agent harnesses like Claude Code and
          Codex. Capturing and retrieving sessions is one of the things it does,
          alongside cross-repo coordination, routing, sandboxing, and policy.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-6">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-base font-medium text-neutral-900 transition-colors hover:text-accent dark:text-neutral-100"
          >
            <span class="underline decoration-accent decoration-2 underline-offset-4">What a meta-harness is</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href="/#capabilities"
            class="inline-flex items-center gap-2 text-base font-medium text-neutral-900 transition-colors hover:text-accent dark:text-neutral-100"
          >
            <span class="underline decoration-accent decoration-2 underline-offset-4">The full capability map</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href="/#landscape"
            class="inline-flex items-center gap-2 text-base font-medium text-neutral-900 transition-colors hover:text-accent dark:text-neutral-100"
          >
            <span class="underline decoration-accent decoration-2 underline-offset-4">Who is building one</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
